[general]
# CD-ROM block device
device = /dev/sr0

# Directory inside MPD's music_directory where the generated CUE file is placed
playlist_dir = /var/lib/mpd/music/CD

# Name of the generated CUE sheet
playlist_name = Audio-CD.cue

# Owner (user:group) applied to playlist_dir (leave empty to skip chown)
owner = mpd:mpd

# Path to local SQLite cache for MusicBrainz lookups
cache_db = /var/cache/mpdcdtag/mb_cache.db

[mpd]
# MPD connection settings
host = localhost
port = 6600

# Relative path to the CUE sheet passed to `mpc load`
mpd_playlist_path = CD/Audio-CD.cue

[musicbrainz]
# Custom User-Agent required by MusicBrainz API guidelines
user_agent = mpd-cd-cue/1.0 (https://github.com/UncleZI/mpd-cd-cue)
